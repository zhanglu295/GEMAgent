# OpenAI-compatible chat-completions endpoint used by review agents.
LLM_API_KEY=replace-me
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_MODEL=replace-me
# Optional model alias used by the GPR reviewer when reasoning is enabled.
LLM_MODEL_THINK=
# Optional explicit dotenv file. When unset, the package searches for .env.
LLM_ENV_FILE=

# Required executables.
GAPSEQ_BIN=/path/to/gapseq
GEMAGENT_RSCRIPT=/path/to/Rscript

# GEMAgent-curated evidence bundle (biomass, media, mimedb, metabolite, reaction).
GEMAGENT_DB_DIR=/path/to/gemagent-data

# Optional paths used by ancillary evaluation and exchange-map utilities.
GEMAGENT_EVAL_ROOT=/path/to/evaluation-data
GEMAGENT_US_DATA_DIR=/path/to/metabolite_uptake_secretion
GEMAGENT_US_REVIEW_DIR=/path/to/us_review/data
GEMAGENT_SEED_METABOLITES=/path/to/seed_metabolites_edited.tsv

# Optional Deep Research reader helpers used by the standalone us_reader scripts.
GEMAGENT_AGENT_DIR=/path/to/agent
GEMAGENT_DEEP_RESEARCH_DIR=/path/to/agent/agent_deepresearch

# Optional runtime tuning.
GEMAGENT_PYTHON=
GEMAGENT_GAPSEQ_DAT_DIR=
GEMAGENT_EXTRA_BIN=
GEMAGENT_LLM_USAGE_LOG=
GEMAGENT_BIOMASS_WORKERS=8
GEMAGENT_GPR_WORKERS=16
GEMAGENT_REVIEW_RETRIES=2
